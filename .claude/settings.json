{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/push-guard.sh\"",
            "timeout": 10,
            "statusMessage": "push 검사 — main 금지·full 도장"
          },
          {
            "type": "command",
            "timeout": 20,
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/commit-guard.sh\"",
            "statusMessage": "커밋 검사 — work/* 는 도장이 있어야"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/pr-base-guard.sh\"",
            "timeout": 10,
            "statusMessage": "PR base 검사"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/java-home-guard.sh\"",
            "timeout": 5,
            "statusMessage": "JAVA_HOME 검사"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/doc-lint-edit.sh\"",
            "timeout": 60,
            "statusMessage": "문서 린트"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/doc-lint-bash.sh\"",
            "timeout": 60,
            "statusMessage": "문서 린트"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/session-state.sh\"",
            "timeout": 15,
            "statusMessage": "현재 상태 주입"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/stop-uncommitted.sh\"",
            "timeout": 15,
            "statusMessage": "커밋 안 된 작업물 검사"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/stop-stamp.sh\"",
            "timeout": 15,
            "statusMessage": "검증 도장 검사"
          }
        ]
      }
    ]
  }
}
