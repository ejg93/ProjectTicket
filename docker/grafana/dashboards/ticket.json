{
  "title": "ProjectTicket — 예매",
  "uid": "ticket-core",
  "description": "ADR 0003 이 정한 넷: 선점 성공률·대기열 길이·응답 p95·오류율. 패널을 더하면 D10 의 이름 표를 먼저 본다.",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "선점 성공률",
      "type": "timeseries",
      "description": "won / (won+taken+rejected). 경합에서 진 것(taken)은 정상이고 규칙에 막힌 것(rejected)이 늘면 화면이나 계약이 틀린 것이다.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(seat_hold_attempts_total{result=\"won\"}[5m])) / clamp_min(sum(rate(seat_hold_attempts_total[5m])), 0.001)",
          "legendFormat": "성공률",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "대기열 — 줄 길이와 활성",
      "type": "timeseries",
      "description": "회차 합이다(D10). 줄이 안 주는데 활성이 정원에 붙어 있으면 들어간 사람이 안 사고 있는 것이다.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "expr": "queue_length", "legendFormat": "대기", "refId": "A" },
        { "expr": "queue_active", "legendFormat": "활성", "refId": "B" }
      ]
    },
    {
      "id": 3,
      "title": "응답 p95",
      "type": "timeseries",
      "description": "HTTP 전체와 선점 트랜잭션. 31 이 이 값으로 D13 의 목표를 정한다.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "HTTP p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(seat_hold_latency_seconds_bucket[5m])))",
          "legendFormat": "선점 p95",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "title": "오류율과 관문 거절",
      "type": "timeseries",
      "description": "5xx 는 우리 잘못이고, 관문 거절(429)은 설계대로 막은 것이다 — 한 그림에 두되 선을 가른다.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))",
          "legendFormat": "5xx",
          "refId": "A"
        },
        {
          "expr": "sum by (reason) (rate(queue_gate_rejected_total[5m]))",
          "legendFormat": "관문 {{reason}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "title": "대기 시간 p95 / 입장 속도",
      "type": "timeseries",
      "description": "입장 속도 R 이 설정값(20/초)과 다르면 스케줄러가 여러 대에서 도는 것이다(33 의 Redis 락).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(queue_wait_seconds_seconds_bucket[5m])))",
          "legendFormat": "대기 p95(초)",
          "refId": "A"
        },
        { "expr": "sum(rate(queue_admitted_total[1m]))", "legendFormat": "입장/초", "refId": "B" }
      ]
    },
    {
      "id": 6,
      "title": "읽기 모델 — 스냅샷 생성",
      "type": "timeseries",
      "description": "폴링 수에 비례해 늘면 캐시가 안 먹는 것이다(D20). 판이 바뀐 횟수에만 비례해야 한다.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(seat_snapshot_built_total[5m]))", "legendFormat": "스냅샷/초", "refId": "A" }
      ]
    }
  ]
}
