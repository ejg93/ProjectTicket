+package com.projectticket.ticket.reservation
+
+import org.springframework.jdbc.core.simple.JdbcClient
+
+internal fun probeOverwrite(jdbc: JdbcClient, id: Long): Int =
+    jdbc.sql(
+        """
+        update performance_seat set status = 'held' where performance_seat_id = :id
+        """,
+    ).param("id", id).update()
