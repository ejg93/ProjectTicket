# 게이트: SqlTextTest 결합(`G10`) — 도우미가 StringBuilder 로 조립해 넘긴 SQL
# 명령: cd backend && ./gradlew test --tests '*SqlTextTest' --no-daemon --build-cache -q; r=$?; cat build/test-results/test/*SqlTextTest.xml 2>/dev/null; exit $r
# 문구: 결합했다
diff --git a/backend/src/main/kotlin/com/projectticket/ticket/reservation/ProbeBuilt.kt b/backend/src/main/kotlin/com/projectticket/ticket/reservation/ProbeBuilt.kt
new file mode 100644
index 0000000..47cc05d
--- /dev/null
+++ b/backend/src/main/kotlin/com/projectticket/ticket/reservation/ProbeBuilt.kt
@@ -0,0 +1,8 @@
+package com.projectticket.ticket.reservation
+
+import org.springframework.jdbc.core.simple.JdbcClient
+
+internal fun probeBuilt(jdbc: JdbcClient, name: String): Int {
+    val built = StringBuilder("update account set display_name = '").append(name).append("' where account_id = 1").toString()
+    return jdbc.sql(built).update()
+}
